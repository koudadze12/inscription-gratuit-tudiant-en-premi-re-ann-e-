<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#160f24">
<title>Pour AGBAH N'tifafa — Ta journée de princesse</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap');
:root{--gold:#e9c77b;--rose:#f3b7c8;--ink:#160f24;--cream:#fff5eb}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:radial-gradient(ellipse at 50% 0%,#4c315c 0,#21152f 43%,#100c1b 100%);color:#fff;font-family:'DM Sans',sans-serif;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.2;background-image:radial-gradient(#fff 1px,transparent 1px);background-size:47px 47px;animation:twinkle 5s ease-in-out infinite alternate}
@keyframes twinkle{from{opacity:.08}to{opacity:.3}}
main{position:relative;z-index:1}.hero{min-height:100svh;display:flex;align-items:center;justify-content:center;text-align:center;padding:70px 20px 55px;position:relative;isolation:isolate;background-image:linear-gradient(180deg,rgba(15,10,24,.62),rgba(18,11,29,.78)),url('data:image/jpeg;base64,');background-size:cover;background-position:center 38%;background-repeat:no-repeat}
.glow{position:absolute;z-index:-1;width:min(75vw,680px);height:min(75vw,680px);border-radius:50%;background:#d69dbd;filter:blur(100px);opacity:.12;top:10%;left:50%;transform:translateX(-50%)}
.eyebrow{letter-spacing:.32em;text-transform:uppercase;color:var(--gold);font-size:.72rem;font-weight:700}
h1{font-family:'Cormorant Garamond',serif;font-size:clamp(4rem,13vw,9rem);line-height:.82;font-weight:600;margin:25px 0 18px;background:linear-gradient(110deg,#fff4dc 10%,#e9c77b 42%,#f3b7c8 75%,#fff);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 12px 60px #e9c77b22}
.subtitle{font-family:'Cormorant Garamond',serif;font-size:clamp(1.35rem,3vw,2rem);color:#f7e7ef;margin:0 auto 28px}
.rule{width:100px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:24px auto}
.intro{max-width:610px;margin:0 auto;color:#e7dce9;line-height:1.8;font-size:1rem}
.actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:32px}
button,.upload-label{border:1px solid #e9c77b99;border-radius:999px;padding:13px 22px;color:#fff;background:#ffffff0d;font:600 .9rem 'DM Sans';cursor:pointer;transition:.25s;backdrop-filter:blur(8px)}
button:hover,.upload-label:hover{transform:translateY(-3px);background:#e9c77b20;box-shadow:0 8px 35px #e9c77b22}
.primary{background:linear-gradient(120deg,#b47b9c,#d39b87);border:0;color:#1c1124}
.float{position:absolute;font-size:clamp(1.4rem,4vw,2.5rem);opacity:.65;animation:float 6s ease-in-out infinite}
.f1{left:9%;top:23%}.f2{right:10%;top:32%;animation-delay:1s}.f3{left:15%;bottom:17%;animation-delay:2s}.f4{right:15%;bottom:14%;animation-delay:3s}
@keyframes float{0%,100%{transform:translateY(0) rotate(-8deg)}50%{transform:translateY(-22px) rotate(8deg)}}
section{padding:85px 20px}.wrap{max-width:1000px;margin:auto}.section-title{text-align:center;font:600 clamp(2.5rem,6vw,4rem) 'Cormorant Garamond';color:var(--gold);margin:0 0 12px}.section-sub{text-align:center;color:#d8c9dc;margin:0 auto 35px;line-height:1.7;max-width:620px}
.photo-card{max-width:650px;margin:0 auto;border:1px solid #e9c77b55;border-radius:28px;padding:12px;background:linear-gradient(145deg,#ffffff16,#ffffff05);box-shadow:0 25px 80px #0005}
.photo-frame{height:430px;border-radius:19px;overflow:hidden;background:linear-gradient(145deg,#392744,#21172e);display:flex;align-items:center;justify-content:center;position:relative}
.photo-frame img{width:100%;height:100%;object-fit:cover;display:none}
.photo-placeholder{text-align:center;padding:25px;color:#e7dce9;line-height:1.7}
.photo-placeholder .icon{font-size:3.5rem;display:block;margin-bottom:12px}
.photo-tools{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;padding:14px 5px 3px}
input[type=file]{display:none}
.message-card{max-width:760px;margin:auto;padding:clamp(25px,5vw,55px);border:1px solid #e9c77b66;border-radius:28px;background:linear-gradient(145deg,#ffffff12,#ffffff05);box-shadow:0 25px 80px #0004;position:relative}
.message-card:before{content:"“";position:absolute;top:-18px;left:24px;font:7rem 'Cormorant Garamond';color:#e9c77b55}
.message-card p{font:clamp(1.2rem,2.5vw,1.55rem)/1.8 'Cormorant Garamond';color:#fff3ed;margin:0 0 16px}
.signature{text-align:right;color:var(--gold);font:italic 1.25rem 'Cormorant Garamond'}
.wish{text-align:center;padding:85px 20px 110px}
.wish-box{max-width:700px;margin:auto;padding:40px 22px;border-radius:30px;background:radial-gradient(ellipse at top,#67415f,#281a36 75%);border:1px solid #e9c77b66}
.wish-box .cake{font-size:4rem;animation:bob 2s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-8px)}}
.wish-box h2{font:600 clamp(2.3rem,6vw,4rem) 'Cormorant Garamond';color:var(--gold);margin:12px 0}
footer{text-align:center;padding:25px;color:#bbaabe;font-size:.8rem;border-top:1px solid #ffffff14}
.music{position:fixed;z-index:5;right:18px;top:18px;border-radius:50%;width:48px;height:48px;padding:0;font-size:1.1rem;background:#21152fcc}
.music.playing{color:var(--gold);box-shadow:0 0 0 5px #e9c77b22}
#toast{position:fixed;z-index:9;bottom:22px;left:50%;transform:translate(-50%,20px);opacity:0;background:#fff3e9;color:#2b1831;padding:13px 20px;border-radius:30px;transition:.3s;text-align:center;max-width:90vw}
#toast.show{opacity:1;transform:translate(-50%,0)}
#confetti{position:fixed;inset:0;pointer-events:none;z-index:8}
@media(max-width:600px){.photo-frame{height:350px}.float{opacity:.35}section{padding:65px 17px}}
</style>
</head>
<body>
<button class="music" id="musicBtn" aria-label="Activer la musique" title="Musique douce">♫</button>
<canvas id="confetti"></canvas>
<main>
<header class="hero">
 <div class="glow"></div><span class="float f1">✧</span><span class="float f2">♡</span><span class="float f3">✦</span><span class="float f4">❀</span>
 <div>
  <div class="eyebrow">Aujourd'hui, le monde te célèbre</div>
  <h1>AGBAH<br>N'tifafa</h1>
  <p class="subtitle">Joyeux anniversaire, Princesse ✨</p><p style="color:#f5e5ee;font-size:.82rem;letter-spacing:.08em;text-shadow:0 2px 12px #000">Une pensée lumineuse pour toi, AGBAH N’tifafa</p>
  <div class="rule"></div>
  <p class="intro">Une journée rien qu'à toi, remplie de douceur, de lumière et de belles émotions. Même à distance, une pensée affectueuse t'accompagne à chaque instant.</p>
  <div class="actions"><button class="primary" onclick="document.getElementById('message').scrollIntoView({behavior:'smooth'})">Découvrir ton message ♡</button><button onclick="celebrate()">Lancer la magie ✨</button></div>
 </div>
</header>
<section id="souvenir">
 <div class="wrap">
  <h2 class="section-title">Un joli souvenir</h2>
  <p class="section-sub">Ajoute sa photo pour rendre cette surprise encore plus personnelle. La photo reste dans ton navigateur.</p>
  <div class="photo-card">
   <div class="photo-frame">
    <img id="portrait" alt="Photo d'AGBAH N'tifafa">
    <div class="photo-placeholder" id="placeholder"><span class="icon">🌷</span><strong>La place de ta plus belle photo</strong><br>Choisis une photo pour l'afficher ici.</div>
   </div>
   <div class="photo-tools"><label class="upload-label" for="photoInput">＋ Ajouter une photo</label><input id="photoInput" type="file" accept="image/*"><button id="removePhoto" type="button">Retirer la photo</button></div>
  </div>
 </div>
</section>
<section id="message">
 <div class="wrap">
  <h2 class="section-title">Quelques mots pour toi</h2>
  <p class="section-sub">Parce que certaines personnes méritent plus qu'un simple « joyeux anniversaire ».</p>
  <article class="message-card">
   <p>Comme je te l'avais dit, aujourd'hui, tu seras la princesse de cette journée.</p>
   <p>Je te souhaite tout le bonheur que tu mérites. Ce serait presque une erreur de la part de ta maman de ne pas avoir fait de toi une princesse pour cette journée, toi qui es comme une fleur capable de parfumer tout ce qui t'entoure.</p>
   <p>Même si je ne suis pas à tes côtés pour célébrer cette journée de gloire, de merveilles et de joie, je veux que tu saches une chose : j'ai ressenti les effets de ta présence dès les premières respirations de cette journée, dès le moment où je me suis réveillé ce matin.</p>
   <p>Mes meilleurs vœux t'accompagnent. Que cette journée soit remarquable, qu'elle reste gravée dans ta mémoire et qu'elle marque le début d'une nouvelle année remplie de bonheur, de réussite et de belles surprises.</p>
   <p>Profite pleinement de ta journée, Princesse. Tu le mérites ! ❤️</p>
   <div class="signature">Avec toute mon affection ♡</div>
  </article>
 </div>
</section>
<section class="wish">
 <div class="wish-box">
  <div class="cake">🎂</div>
  <h2>Fais un vœu, Princesse</h2>
  <p class="intro">Ferme les yeux un instant, pense à ce qui te rend heureuse… et laisse cette nouvelle année t'apporter de merveilleuses surprises.</p>
  <div class="actions"><button class="primary" onclick="celebrate()">Que ton vœu se réalise 💜</button></div>
 </div>
</section>
<footer>Conçu avec affection pour AGBAH N'tifafa · Que ta lumière continue de briller ✨</footer>
</main>
<div id="toast">Que tous tes vœux se réalisent, Princesse ! 💜</div>
<script>
const photoInput=document.getElementById('photoInput'),portrait=document.getElementById('portrait'),placeholder=document.getElementById('placeholder');
let currentUrl=null;
photoInput.addEventListener('change',e=>{const f=e.target.files&&e.target.files[0];if(!f)return;if(!f.type.startsWith('image/'))return; if(currentUrl)URL.revokeObjectURL(currentUrl);currentUrl=URL.createObjectURL(f);portrait.src=currentUrl;portrait.style.display='block';placeholder.style.display='none';});
document.getElementById('removePhoto').addEventListener('click',()=>{portrait.removeAttribute('src');portrait.style.display='none';placeholder.style.display='block';photoInput.value='';if(currentUrl)URL.revokeObjectURL(currentUrl);currentUrl=null;});
let audioCtx=null,oscillators=[],musicOn=false;
function musicToggle(){const btn=document.getElementById('musicBtn');if(!musicOn){audioCtx=audioCtx||new (window.AudioContext||window.webkitAudioContext)();audioCtx.resume();const master=audioCtx.createGain();master.gain.value=.035;master.connect(audioCtx.destination);[[174.61,0],[220,0.04],[261.63,0.08]].forEach(([freq,detune])=>{const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.value=freq*(1+detune);g.gain.value=.25;o.connect(g);g.connect(master);o.start();oscillators.push(o);});musicOn=true;btn.classList.add('playing');btn.textContent='♫';btn.title='Désactiver la musique';}else{oscillators.forEach(o=>{try{o.stop()}catch(e){}});oscillators=[];musicOn=false;btn.classList.remove('playing');btn.title='Activer la musique';}}
document.getElementById('musicBtn').addEventListener('click',musicToggle);
const canvas=document.getElementById('confetti'),ctx=canvas.getContext('2d');let pieces=[],animating=false;
function resize(){canvas.width=innerWidth*devicePixelRatio;canvas.height=innerHeight*devicePixelRatio;ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0)}addEventListener('resize',resize);resize();
function celebrate(){const colors=['#e9c77b','#f3b7c8','#c7a5f2','#fff0df','#ef795f'];for(let i=0;i<170;i++)pieces.push({x:innerWidth/2+(Math.random()-.5)*180,y:innerHeight*.42,vx:(Math.random()-.5)*9,vy:Math.random()*-10-3,size:Math.random()*7+3,rot:Math.random()*6,color:colors[Math.floor(Math.random()*colors.length)],life:130+Math.random()*60});const toast=document.getElementById('toast');toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),3200);if(!animating)frame();}
function frame(){animating=true;ctx.clearRect(0,0,innerWidth,innerHeight);pieces=pieces.filter(p=>p.life>0&&p.y<innerHeight+30);for(const p of pieces){p.x+=p.vx;p.y+=p.vy;p.vy+=.13;p.vx*=.992;p.rot+=.08;p.life--;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot);ctx.fillStyle=p.color;ctx.fillRect(-p.size/2,-p.size/2,p.size,p.size*.65);ctx.restore();}if(pieces.length)requestAnimationFrame(frame);else{ctx.clearRect(0,0,innerWidth,innerHeight);animating=false;}}
</script>
</body>
</html>
